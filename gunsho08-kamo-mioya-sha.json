 "poems": [
  {
   "seq": "1",
   "text": "都にもわかゝたをかの朝かすみへたつるいろの袖にうつれる",
   "kana": "",
   "speaker": "",
   "page": 207,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "人はこす霞はとつる松の戶にあすかねぬよのなにかあくらん",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "山かけのかすみの衣ほころひて春風さむきあさあけの袖",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "やとちかにふかくやみゆる朝かすみ冬のなこりのしはの煙を",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "たつれてもけさは霞のそことたにたれかみやまのおくの庵を",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "宮古人とふともけさはしら雲の八重たつ山のなをかすみ行",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "明わたる峰のしはやのよそめたにわすらるはかり霞むころ哉",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "あさ露のをのへの山のたま柳さかひもとをくかすむ春かな",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "朝かすみたつをたまきを友とみて春もとはれぬ谷のかよひち",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "けさはしも霞もふかしおく山とたのめし人にうらみ殘すな",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "けふはくれぬあすは麓のゆきてみむなからの山の嵐ふくめり",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "花の色もうつりもゆくかさゝ浪やなからの山の春のゆふ暮",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "からさきや志賀に散花色そこきひよしの山にいもひさすほと",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "なかむれは花よりほかの色もなし夕なみつゝく志賀の浦かせ",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "にほてるや夕日をこめてひくあみのさゝ浪白くよるさくら哉",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "暮ゆけととまりさためぬつり船の花にそやとる志賀のから崎",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "志賀の山もるや梢の夕つく日ちりかひくもる花の下かせ",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "浦かけてちりかふ花のさゝ浪や志賀のゆふ風山に吹らし",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "志賀の浦や釣する船の袖もみなさくらなからの山の夕かせ",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "花やふく釣するあまの袖のうへにぬれぬなみこすしかの夕風",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "志賀のうみ入日うつろふ水の面は散てもまかふ花のうき雲",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "とまやかたゆふへの浪に袖ぬれて花こそかほれ志賀のから崎",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "みつかきや我世のはしめ契をきしその〓とのはを神やうけゝむ",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "君かためいのりをきけん萬代のはるとも神そ空にしるらん",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "守るらん法のためにもみそきせんかたなひきなる塵や拂ふと",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "ふりにけりなくよのすゑを哀とも誰かはくまんかもの水かき",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "わたのはらしほ路がすみて行雁のつはさにかゝるおきつ白浪",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
